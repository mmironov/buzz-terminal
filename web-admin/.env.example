# Copy to .env.local (gitignored) and fill in from the Firebase console:
# Project settings → General → Your apps → Web app → SDK setup and configuration.
#
# If there is no web app registered yet, add one there first. It needs no hosting
# site and no extra SDK snippet — only these five values.
#
# These are not secrets. A Firebase web config identifies the project and is
# shipped inside every web app that talks to it; what stops a stranger reading the
# roster is `firestore.rules` plus the `admin` custom claim, not the obscurity of
# an API key. They live in an env file anyway, to match how the iOS and Android
# apps keep GoogleService-Info.plist and google-services.json out of git — one rule
# about project configuration is easier to hold than two.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=swing-buzz.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=swing-buzz
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set by `npm run dev:emulator` via .env.emulator — do not set it here. Pointing a
# production build at an emulator would show an empty festival and accept writes
# that go nowhere.
# VITE_USE_EMULATOR=
