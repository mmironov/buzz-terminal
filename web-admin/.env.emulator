# `npm run dev:emulator` loads this on top of .env.local.
#
# Committed on purpose: there is nothing here to keep private, and the values are
# what make a fresh clone able to run against `firebase emulators:start` with no
# Firebase project and no credentials at all. The api key is ignored by the Auth
# emulator but the SDK insists on a non-empty one.
VITE_USE_EMULATOR=1
VITE_FIREBASE_API_KEY=emulator-ignores-this
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=swing-buzz
VITE_FIREBASE_APP_ID=1:0:web:0
VITE_FIREBASE_MESSAGING_SENDER_ID=0
