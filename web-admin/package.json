{
  "name": "buzz-web-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Swing Buzz organiser panel: participants, bracelet blocks, purchase history and the drinks menu.",
  "scripts": {
    "dev": "vite",
    "dev:emulator": "vite --mode emulator",
    "seed:history": "node scripts/seed-history.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting --project swing-buzz"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
