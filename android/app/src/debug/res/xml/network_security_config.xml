<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only — this file lives in src/debug/ and is merged into nothing
  else. A release build keeps the platform default, which is that cleartext is
  refused everywhere.

  The Firebase emulators speak plain HTTP, and since API 28 Android refuses
  cleartext by default. Without this, an emulator run fails at the first request
  with "Cleartext HTTP traffic to 10.0.2.2 not permitted" — which surfaces in the
  app as a generic auth failure, because that is all the Auth SDK can tell us.

  Scoped to the two hosts that can only mean a local emulator: 10.0.2.2 is the
  host machine as seen from inside the Android emulator, and localhost is the
  device itself for a port-forwarded setup. Blanket android:usesCleartextTraffic
  would have been one attribute and would have permitted cleartext to anywhere.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
