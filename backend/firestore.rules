rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  Swing Buzz Staff Terminal — Firestore security rules
//
//  The terminals write to Firestore directly rather than through Cloud
//  Functions. That is a deliberate choice: the bar needs to keep taking orders
//  when the wifi drops, and Firestore's offline persistence only works for
//  client writes — a callable function simply fails when offline. So the money
//  rules have to live here, where they are enforced no matter what the app
//  binary does.
//
//  Four invariants these rules exist to hold:
//
//    1. A balance can only move by exactly the amount of a matching ledger
//       entry, written in the same transaction. No naked balance writes.
//    2. Reception can only credit; the bar can only debit. Enforced from the
//       staff member's custom claim, not from anything the client sends.
//    3. The ledger is append-only, and a transaction's document id IS its
//       idempotency key — so a replayed offline write collides instead of
//       double-charging.
//    4. A charge's itemisation adds up to the amount charged. The receipt the
//       admin panel shows and the money that left the bracelet are the same
//       fact, not two facts that happen to agree.
//
//  Roster fields (name, ticket type, city) are never client-writable. They come
//  from the Google Sheet import, which runs with the Admin SDK and bypasses
//  these rules entirely.
//
//  There are three roles, and they are disjoint. `reception` and `bar` are the
//  terminals; `admin` is the web panel in `web-admin/`, which blocks bracelets
//  and owns the drinks catalogue. An admin deliberately CANNOT move money: no
//  balance write, no ledger entry, no pairing. Blocking is the organiser's lever,
//  and every euro on a bracelet stays accounted for by the ledger.
//
//  See docs/firestore-schema.md for the model and the reasoning.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Identity ───────────────────────────────────────────────────────────

    // `role` is a custom claim set with the Admin SDK, never by the client. A
    // staff member cannot promote themselves from bar to reception, and nobody
    // can promote themselves to admin.
    function role() {
      return request.auth.token.get('role', '');
    }
    function isStaff() {
      return request.auth != null && role() in ['reception', 'bar', 'admin'];
    }

    // `admin` counts as reception. An organiser is the person who ends up on the
    // desk when it is busy, and having to hand them a second account to check
    // somebody in was friction with no security benefit — they can already set
    // prices and freeze bracelets.
    //
    // What this grants, deliberately: pairing bracelets, selling evening tickets,
    // and crediting balances. Every one of those writes a ledger entry stamped
    // with `staffUid`, so an organiser's top-up is as auditable as anyone else's.
    function isReception() {
      return request.auth != null && role() in ['reception', 'admin'];
    }

    // `admin` is NOT included here, and that is the line that still holds: an
    // organiser cannot take money off a bracelet. Credit is reversible by
    // crediting again; a charge is what a guest disputes at the bar. Keeping the
    // debit side to one role means "who spent this?" always has one answer.
    function isBar() {
      return request.auth != null && role() == 'bar';
    }

    // The organiser at the web admin panel: the menu, and freezing a bracelet.
    function isAdmin() {
      return request.auth != null && role() == 'admin';
    }

    // Reads are open to every signed-in role. `isAdmin()` is now redundant here
    // because admin is in isStaff(), and is left in place so that narrowing
    // isStaff() again cannot silently take the panel's reads away with it.
    function canRead() {
      return isStaff() || isAdmin();
    }

    // ── Document refs ──────────────────────────────────────────────────────

    function participantRef(pid) {
      return /databases/$(database)/documents/participants/$(pid);
    }
    function txRef(pid, txId) {
      return /databases/$(database)/documents/participants/$(pid)/transactions/$(txId);
    }
    function braceletRef(chipUid) {
      return /databases/$(database)/documents/bracelets/$(chipUid);
    }
    function passRef(passId) {
      return /databases/$(database)/documents/doorPasses/$(passId);
    }

    // ── Participants ───────────────────────────────────────────────────────

    match /participants/{participantId} {

      allow read: if canRead();

      // Nobody deletes a person mid-festival.
      allow delete: if false;

      // The one hole in "the roster belongs to the Sheet". Passes are sold at the
      // door too, and those buyers have no Sheet row — so reception has to be
      // able to create a participant.
      //
      // Two shapes, and only these two:
      //
      //   · an EVENING TICKET, numbered per evening, carrying a name and the
      //     night and nothing else;
      //   · a DOOR PASS, which also carries a dance role and a level.
      //
      // The door pass widens this hole on purpose, and it is worth naming what
      // was given up: this rule used to say reception "cannot invent a Full Pass
      // Gold for a friend", and now it can. That is the feature — a 259 € pass
      // sold on the night is a real thing the desk does. What survives is the
      // part that protects the money: no balance, no ledger entry, no block
      // state, no overwriting an existing document, and a pass type that an
      // organiser has actually priced in `doorPasses`. Reception can sell what
      // the festival sells, at the desk, and nothing else.
      allow create: if isReception()
        && (isWellFormedEveningTicket(participantId) || isWellFormedDoorPass(participantId));

      function isWellFormedEveningTicket(pid) {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'source', 'ticketType', 'evening', 'eveningNumber', 'ticketRef',
                 'name', 'nameLower', 'searchTokens', 'country',
                 'braceletId', 'checkedInAt', 'balance', 'lastTxId',
                 'isBlocked', 'blockReason', 'createdBy'
               ])
          && d.keys().hasAll([
               'source', 'ticketType', 'evening', 'eveningNumber', 'ticketRef',
               'name', 'country', 'braceletId', 'checkedInAt', 'balance',
               'isBlocked', 'createdBy'
             ])
          // It is an evening ticket, and it says so in every field that matters.
          && d.source == 'evening'
          && d.ticketType == 'Evening Ticket'
          && d.evening in ['friday', 'saturday', 'sunday']
          && d.eveningNumber is int
          && d.eveningNumber > 0
          // The id IS the sequence number, so Firestore's create-fails-if-exists
          // does the deduplication: two desks selling at the same moment collide
          // on ev-friday-14 and the loser retries with 15. These three checks are
          // what stop the id and the contents drifting apart.
          && pid == 'ev-' + d.evening + '-' + string(d.eveningNumber)
          && d.ticketRef == 'EV-' + d.evening.upper() + '-' + string(d.eveningNumber)
          // The guest's name. These used to be anonymous, with `name` pinned to
          // the generated label "Evening #14"; the festival decided it wants to
          // know who holds one. The number they are reconciled by is still the
          // id and `ticketRef`, both of which are still pinned above.
          //
          // Bounded and nothing more — `nameLower` is deliberately not checked
          // against it, for the reason written out under the door pass below:
          // rules' `.lower()` is ASCII-only, and most of this roster is not.
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.nameLower is string && d.nameLower.size() <= 80
          && d.searchTokens is list && d.searchTokens.size() <= 12
          // A name and the night, and still nothing else. No country, and — as
          // the `hasOnly` above enforces — no email, no phone, no level, no
          // dance role. One night at a door asks one question.
          && d.country == ''
          // The ticket price is cash to the festival, not credit on the bracelet.
          && d.balance == 0
          && d.get('lastTxId', null) == null
          // Blocking is an organiser action, including for these: an expired
          // evening ticket is frozen by hand from the admin panel.
          && d.isBlocked == false
          && d.get('blockReason', null) == null
          && d.createdBy == request.auth.uid
          && d.checkedInAt == request.time
          // Paired in the same batch, and the reverse lookup must agree.
          && d.braceletId is string
          && getAfter(braceletRef(d.braceletId)).data.participantId == pid;
      }

      // A pass sold at the door: a Full Pass, a Party Pass, whatever the
      // organisers have put in the catalogue at a price.
      //
      // Unlike an evening ticket this one has a buyer. The name, the dance role
      // and the level sit on the document, where every terminal can read them —
      // which is exactly what the Sheet-imported roster already exposes, so a
      // door buyer is no more visible than anybody else. **The email does not
      // live here.** It goes in `contact/details`, which only reception and the
      // organiser panel can read; see the rule below and docs/door-sales.md.
      function isWellFormedDoorPass(pid) {
        let d = request.resource.data;
        return d.keys().hasOnly([
                 'source', 'passId', 'ticketType', 'doorNumber', 'ticketRef',
                 'name', 'nameLower', 'searchTokens', 'country', 'level',
                 'danceRole', 'braceletId', 'checkedInAt', 'balance', 'lastTxId',
                 'isBlocked', 'blockReason', 'createdBy'
               ])
          && d.keys().hasAll([
               'source', 'passId', 'ticketType', 'doorNumber', 'ticketRef',
               'name', 'country', 'danceRole', 'braceletId', 'checkedInAt',
               'balance', 'isBlocked', 'createdBy'
             ])
          && d.source == 'door'
          // The id IS the sequence number, so two desks selling at the same
          // moment collide on `door-7` and the loser retries with 8. Same
          // deduplication-by-construction as the evening ticket above.
          && d.doorNumber is int
          && d.doorNumber > 0
          && pid == 'door-' + string(d.doorNumber)
          && d.ticketRef == 'DOOR-' + string(d.doorNumber)
          // Only what an organiser has priced, spelled the way they spelled it.
          // This is the check that replaces "reception cannot invent a pass
          // type": it can sell a Full Pass Gold, because the festival sells one,
          // and it cannot sell a "Full Pass Platinum" that exists nowhere.
          && d.passId is string
          && exists(passRef(d.passId))
          && get(passRef(d.passId)).data.name == d.ticketType
          // A real name. Bounded and nothing more.
          //
          // This said `d.nameLower == d.name.lower()` for about an hour, which
          // would have refused half the festival. **Rules' `.lower()` is
          // ASCII-only** — measured against the emulator, not assumed: a
          // document naming "Łukasz" was accepted only when `nameLower` still
          // held the capital Ł, and the correctly lowercased "łukasz" that Swift
          // and every search box produce was refused. Polish, Czech and
          // Bulgarian names are most of this roster, so the check had to go. What
          // it protected against — a terminal filing somebody under a name the
          // panel does not show — is a trusted reception account mislabelling its
          // own sale, which is a much smaller problem than a queue at the door.
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.nameLower is string && d.nameLower.size() <= 80
          && d.searchTokens is list && d.searchTokens.size() <= 12
          // No country at the door. It is in the Sheet for registrations because
          // the Sheet asks; nobody is asking at 23:40 on a Saturday.
          && d.country == ''
          && d.danceRole in ['leader', 'follower']
          // Levels are the four the panel offers, and only Full Pass and Full
          // Pass Gold actually split by them — the app offers the field for
          // those two alone. Empty is always allowed, so the rule does not have
          // to know which pass types those are.
          && d.get('level', '') in ['', 'Intermediate', 'Advanced', 'Pro', 'Other']
          // The price is cash to the festival, not credit on the bracelet — the
          // same line the evening ticket holds.
          && d.balance == 0
          && d.get('lastTxId', null) == null
          && d.isBlocked == false
          && d.get('blockReason', null) == null
          && d.createdBy == request.auth.uid
          && d.checkedInAt == request.time
          && d.braceletId is string
          && getAfter(braceletRef(d.braceletId)).data.participantId == pid;
      }

      // ── Contact details ──────────────────────────────────────────────────
      //
      // The buyer's email, and nothing else. It is here rather than on the
      // participant for one reason: a participant document is readable by every
      // signed-in terminal, and the bar has no business holding a mailing list.
      // Same reasoning, same shape as the merch subcollection below.
      match /contact/{contactId} {
        allow read: if isReception();
        allow delete: if false;
        allow create, update: if isReception() && isWellFormedContact();

        function isWellFormedContact() {
          let d = request.resource.data;
          return d.keys().hasOnly(['email', 'addedBy', 'addedAt'])
            && d.keys().hasAll(['email', 'addedBy', 'addedAt'])
            // Not a validating regex — an address the desk mistypes is a support
            // problem, not a security one, and a strict pattern here would
            // refuse the sale rather than the typo. This is a length and shape
            // bound: something with an @ in it, or nothing at all.
            && d.email is string
            && d.email.size() <= 120
            && (d.email == '' || d.email.matches('^[^@\\s]+@[^@\\s]+$'))
            && d.addedBy == request.auth.uid
            && d.addedAt == request.time;
        }
      }

      allow update: if isStaff()
        && touchesOnlyTerminalFields()
        && blockStaysUntouched()
        && pairingIsLegal(participantId)
        && balanceMovesOnlyWithLedger(participantId);

      // The admin panel's one write to a person: freeze the bracelet, or thaw
      // it. Deliberately the narrowest hole that does the job — an organiser can
      // stop a bracelet being used and can say why, and can do nothing else.
      // Not the balance: money moved by a ledger entry stays that way, and an
      // adjustment that left no trace is exactly what the ledger exists to
      // prevent. Not the roster either; that still belongs to the Sheet.
      allow update: if isAdmin() && isBlockChange();

      function isBlockChange() {
        let after = request.resource.data;
        return after.diff(resource.data).affectedKeys()
                 .hasOnly(['isBlocked', 'blockReason', 'blockedBy', 'blockedAt'])
          && after.isBlocked is bool
          // Who and when, on the server's clock. A block is an organiser
          // decision somebody has to be able to ask about afterwards.
          && after.blockedBy == request.auth.uid
          && after.blockedAt == request.time
          // A block must say why: the reason is shown verbatim to the guest on
          // the terminal's blocked screen, so an empty one is a dead end for
          // whoever is standing at the desk.
          && (after.isBlocked
                ? (after.blockReason is string
                     && after.blockReason.size() > 0
                     && after.blockReason.size() <= 300)
                : after.get('blockReason', null) == null);
      }

      // Everything else — name, ticketType, city, isBlocked — is off limits.
      function touchesOnlyTerminalFields() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'lastTxId', 'braceletId', 'checkedInAt', 'updatedAt']);
      }

      function changed(field) {
        return field in request.resource.data.diff(resource.data).affectedKeys();
      }

      // A blocked bracelet is frozen: an organiser lifts it from the web admin
      // panel, and no terminal may either lift it or move money on it.
      function blockStaysUntouched() {
        return !changed('isBlocked')
          && resource.data.get('isBlocked', false) == false;
      }

      // "This bracelet is permanently paired with …" — the design means it.
      // Pairing is reception-only, one-way, and must agree with the reverse
      // lookup document written in the same transaction.
      function pairingIsLegal(pid) {
        return !changed('braceletId')
          || (
            isReception()
            && resource.data.get('braceletId', null) == null
            && request.resource.data.braceletId is string
            && getAfter(braceletRef(request.resource.data.braceletId)).data.participantId == pid
          );
      }

      // The invariant that matters. Either the balance did not move, or it moved
      // by exactly the signed amount of a brand-new ledger entry written by the
      // same staff member in the same transaction.
      function balanceMovesOnlyWithLedger(pid) {
        return (
          !changed('balance') && !changed('lastTxId')
        ) || (
          changed('balance')
          && changed('lastTxId')
          && request.resource.data.lastTxId is string
          && request.resource.data.lastTxId != resource.data.get('lastTxId', '')
          && ledgerEntryBacksTheDelta(pid)
        );
      }

      function ledgerEntryBacksTheDelta(pid) {
        let entry = getAfter(txRef(pid, request.resource.data.lastTxId)).data;
        return request.resource.data.balance == resource.data.balance + entry.signedAmount
          && entry.staffUid == request.auth.uid;
      }

      // ── Preordered merch ─────────────────────────────────────────────────
      //
      // A subcollection rather than fields on the participant, and that is the
      // entire point of it being here. Every field on a participant document is
      // readable by every signed-in terminal, the bar included, which is why
      // the Sheet's t-shirt columns were excluded from the import in the first
      // place. They are imported now, into a document `isBar()` cannot read.
      //
      // A bartender pouring a gin and tonic has no business knowing what size
      // somebody wears. Reception hands the shirt over, so reception reads it.
      match /merch/{merchId} {

        // Not `canRead()`. The narrower rule is the feature.
        allow read: if isReception();

        // The order comes from the Sheet, through the Admin SDK, which bypasses
        // rules entirely. No client creates one, and no client deletes one —
        // the record that a shirt was handed over outlives the festival.
        allow create, delete: if false;

        // Two documents live here, and they are not the same shape:
        //
        //   · `order`     — what somebody PAID for in advance. The Sheet decides
        //                   the item, the size and the colour; the terminal may
        //                   only say it was handed over.
        //   · `freeShirt` — who is owed one for nothing. The Sheet decides only
        //                   THAT; the size and colour are picked at the desk off
        //                   whatever is in the box, so the terminal writes those
        //                   too.
        //
        // Both are reversible on purpose, unlike a bracelet pairing: the cost of
        // a mis-tap is a guest being told their shirt is already gone, and the
        // fix should not need an organiser with a database open.
        allow update: if isReception() && (
          (merchId == 'order' && isCollectionChange())
          || (merchId == 'freeShirt' && isFreeShirtHandover())
        );

        function isFreeShirtHandover() {
          let after = request.resource.data;
          return after.diff(resource.data).affectedKeys()
                   .hasOnly(['size', 'colour', 'collectedAt', 'collectedBy'])
            // `entitled` is the Sheet's word and the terminal cannot touch it —
            // the `hasOnly` above sees to that. Nothing is handed over to
            // somebody who is not on the list, and somebody taken off the list
            // keeps whatever record already exists.
            && resource.data.get('entitled', false) == true
            && (after.collectedAt == null
                  ? after.get('collectedBy', null) == null
                  // Server clock, same as everywhere else money or goods move.
                  : (after.collectedAt == request.time
                       && after.collectedBy == request.auth.uid))
            // Handing one over means saying which one. A record of "a shirt,
            // size unknown" is how somebody ends up with a second shirt.
            && (after.collectedAt == null
                  || (after.get('size', null) != null && after.get('colour', null) != null))
            // Bounds, not a catalogue. The app offers the four sizes and four
            // colours the festival printed; pinning the list here would make a
            // fourth copy of a decision that changes every year, and the failure
            // it would prevent — a typo in a size — is one somebody can see on
            // the screen in front of them.
            && (after.get('size', null) == null
                  || (after.size is string && after.size.size() > 0 && after.size.size() <= 8))
            && (after.get('colour', null) == null
                  || (after.colour is string && after.colour.size() > 0 && after.colour.size() <= 40));
        }

        function isCollectionChange() {
          let after = request.resource.data;
          return after.diff(resource.data).affectedKeys()
                   .hasOnly(['collectedAt', 'collectedBy'])
            // What was ordered belongs to the Sheet. A terminal that could edit
            // `item` could turn a tote bag into a t-shirt.
            && (after.collectedAt == null
                  ? after.get('collectedBy', null) == null
                  // Server clock. A phone with a wrong date must not be able to
                  // record a collection that happened before the festival.
                  : (after.collectedAt == request.time
                       && after.collectedBy == request.auth.uid))
            // Nothing is collected that was never ordered.
            && resource.data.get('item', 'none') != 'none';
        }
      }

      // ── The ledger ───────────────────────────────────────────────────────

      match /transactions/{txId} {

        allow read: if canRead();

        // Append-only. A dispute at the bar is answered by reading history, so
        // history must not be editable — not even by the person who wrote it.
        // The admin panel reads this and cannot write it, which is the point:
        // the organiser sees the ledger, nobody edits the ledger.
        allow update, delete: if false;

        allow create: if isStaff()
          && idIsTheIdempotencyKey()
          && shapeIsExact()
          && itemisationAddsUp()
          && signAgreesWithRole()
          && participantAcceptsMoney()
          && doesNotOverdraw();

        // The client generates a UUID per attempt and uses it as the document
        // id. Iteration 3's offline queue can therefore replay a write blindly:
        // if it already landed, the create fails on "already exists" instead of
        // charging the guest twice. Idempotency by construction, not by check.
        function idIsTheIdempotencyKey() {
          return txId == request.resource.data.clientTxId;
        }

        function shapeIsExact() {
          let d = request.resource.data;
          return d.keys().hasOnly([
                   'clientTxId', 'type', 'amount', 'signedAmount',
                   'staffUid', 'terminalId', 'createdAt', 'queuedOffline',
                   'items', 'method'
                 ])
            && d.keys().hasAll([
                 'clientTxId', 'type', 'amount', 'signedAmount',
                 'staffUid', 'terminalId', 'createdAt'
               ])
            && d.type in ['topup', 'charge']
            && d.amount is int
            && d.amount > 0
            && d.signedAmount is int
            && d.signedAmount == (d.type == 'topup' ? d.amount : -d.amount)
            && d.staffUid == request.auth.uid
            && d.terminalId is string
            && methodIsSane(d)
            // Server clock, not the phone's. An offline terminal with a wrong
            // date must not be able to backdate a charge.
            && d.createdAt == request.time;
        }

        // How the money reached the desk: `cash` or `card`. Mandatory on a
        // top-up, forbidden on a charge.
        //
        // Mandatory here and not only in the app, by an explicit decision. The
        // app's own check can be lost in a build that skips it; this cannot. The
        // cash box is counted against these entries after the festival, and an
        // entry that merely says money arrived is one the count can never be
        // reconciled with — so an unmethodded top-up is refused rather than
        // recorded as a permanent hole.
        //
        // **The cost is real and is the point.** Every terminal that takes money
        // must send it. A build without the picker — TestFlight 77 and earlier,
        // and Android until it carries the same change — has its top-ups denied
        // at the desk. Ship the terminals before a festival that uses these
        // rules.
        //
        // A charge may not carry one at all. It moves money that is already on
        // the bracelet, so a method there would be a claim about a different
        // transaction, and two records of one fact are how two records come to
        // disagree.
        function methodIsSane(d) {
          return d.type == 'topup'
            ? ('method' in d && d.method in ['cash', 'card'])
            : !('method' in d);
        }

        // ── Itemisation ──────────────────────────────────────────────────────
        //
        // A charge carries the round it paid for: `items`, one entry per distinct
        // drink, each a snapshot of what that drink was called and cost AT THE
        // MOMENT OF SALE. Snapshotted rather than referenced, because a price
        // change next Tuesday must not rewrite last Friday's receipt — and because
        // it lets an organiser delete a drink from the menu without orphaning the
        // history that names it.
        //
        // The line totals must add up to `amount`, which is the number the balance
        // actually moved by. Without that check the receipt would be a claim by
        // the bar terminal rather than a fact about the money.
        //
        // **Rules cannot loop.** There is no reduce, no map, no recursion — so the
        // sum below is unrolled, and the cap of eight lines is what makes the
        // unrolling total rather than a check of the first few and a shrug at the
        // rest. A ninth line is refused loudly rather than counted silently.
        //
        // Eight is not a taste decision. Firestore stops evaluating after 1,000
        // expressions per request, and this whole check runs inside a two-document
        // batch that is already spending expressions on the balance invariant.
        // Ten lines exceeded that budget — found by running the tests, which
        // failed with "maximum of 1000 expressions to evaluate has been reached"
        // rather than by anything visible in the rule. Everything below is
        // written for cheapness as much as clarity: each line is indexed once and
        // handed to a helper, because `items[i]` repeated eight times costs eight
        // times as much. Raising the cap means re-measuring, not just editing 8.
        function itemisationAddsUp() {
          let d = request.resource.data;
          let items = d.get('items', []);
          return d.type == 'topup'
            // Cash over the counter buys nothing. There is no round to itemise.
            ? !('items' in d)
            : items is list
              && items.size() >= 1
              && items.size() <= 8
              && lineAt(items, 0) && lineAt(items, 1)
              && lineAt(items, 2) && lineAt(items, 3)
              && lineAt(items, 4) && lineAt(items, 5)
              && lineAt(items, 6) && lineAt(items, 7)
              && itemsTotal(items) == d.amount;
        }

        // True for indices past the end, so the unrolled chain above terminates.
        // `||` short-circuits, so `items[i]` is never evaluated out of bounds.
        function lineAt(items, i) {
          return i >= items.size() || lineIsWellFormed(items[i]);
        }

        function lineIsWellFormed(line) {
          // `hasOnly` and nothing else: a missing key is caught by the type
          // checks below, since reading one that is not there is an evaluation
          // error and an evaluation error denies the write. So there is no
          // `hasAll` here — it would cost a second pass over the keys to reject
          // exactly the same documents.
          return line.keys().hasOnly(['drinkId', 'name', 'unitPrice', 'quantity'])
            && line.drinkId is string
            && line.name is string
            // Zero is allowed: a free glass of water is a menu item, and a round
            // that is free in total is refused anyway by `amount > 0` above.
            && line.unitPrice is int && line.unitPrice >= 0
            && line.quantity is int && line.quantity > 0;
        }

        function itemsTotal(items) {
          return lineTotal(items, 0) + lineTotal(items, 1) + lineTotal(items, 2)
               + lineTotal(items, 3) + lineTotal(items, 4) + lineTotal(items, 5)
               + lineTotal(items, 6) + lineTotal(items, 7);
        }

        function lineTotal(items, i) {
          return i < items.size() ? lineSubtotal(items[i]) : 0;
        }

        function lineSubtotal(line) {
          return line.unitPrice * line.quantity;
        }

        // Reception takes cash and credits. The bar serves drinks and debits.
        // Neither can do the other's job, whatever the app is compiled to send.
        function signAgreesWithRole() {
          let type = request.resource.data.type;
          return (isReception() && type == 'topup')
              || (isBar() && type == 'charge');
        }

        function participantAcceptsMoney() {
          let p = get(participantRef(participantId)).data;
          return p.get('isBlocked', false) == false
            && p.get('braceletId', null) != null;
        }

        // No credit at this festival.
        function doesNotOverdraw() {
          return getAfter(participantRef(participantId)).data.balance >= 0;
        }
      }
    }

    // ── Bracelet → participant reverse lookup ──────────────────────────────
    //
    // Document id is the NFC chip UID, so a scan is a single point read by id:
    // no query, no index, and it works straight out of the offline cache.

    match /bracelets/{chipUid} {

      allow read: if canRead();

      allow create: if isReception()
        && request.resource.data.keys().hasOnly(['participantId', 'staffUid', 'pairedAt'])
        && request.resource.data.staffUid == request.auth.uid
        && request.resource.data.pairedAt == request.time
        && getAfter(participantRef(request.resource.data.participantId)).data.braceletId == chipUid;

      // Permanent pairing. Re-assigning a chip to a different guest would
      // silently transfer their balance; a fresh bracelet is the answer.
      allow update, delete: if false;
    }

    // ── Drinks menu ────────────────────────────────────────────────────────

    match /drinks/{drinkId} {
      allow read: if canRead();

      // Prices are set by organisers, not by the bar. Until the admin panel
      // existed this said `allow write: if false` and the menu was seeded with
      // the Admin SDK; the authority has moved, not widened. No terminal can
      // still write here, whatever it is compiled to send.
      allow create, update: if isAdmin() && isWellFormedDrink();

      // Deleting used to be forbidden on the grounds that it would orphan the
      // ledger lines naming the drink. Those lines now snapshot the name and
      // price at the moment of sale (see `itemisationAddsUp`), so history is
      // self-contained and a drink entered by mistake can simply go.
      //
      // It is still the wrong tool for a drink that ran out: `isActive: false`
      // takes it off the bar's menu instantly and can be undone. The panel
      // offers both and says which is which.
      allow delete: if isAdmin();

      function isWellFormedDrink() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'price', 'sortOrder', 'isActive'])
          && d.keys().hasAll(['name', 'price', 'sortOrder', 'isActive'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 60
          // Cents, never a float — the same integer discipline as `balance`.
          // Zero is a legitimate price; the ceiling is a typo bound, not a
          // policy, and 1000 € is well clear of any real drink.
          && d.price is int && d.price >= 0 && d.price <= 100000
          && d.sortOrder is int && d.sortOrder >= 0
          && d.isActive is bool;
      }
    }

    // ── Door passes ──────────────────────────────────────────────────────
    //
    // What reception may sell at the desk, and what to charge for it. One
    // document per pass, keyed by a slug of its name, owned by organisers in the
    // admin panel — the same arrangement as the drinks menu, for the same
    // reason: prices are an organiser decision and no terminal writes them.
    //
    // The price is **shown, never charged**. Nothing in this system takes the
    // money for a pass; the desk does, in cash or on the card machine, and the
    // number here is what they say out loud. It deliberately does not become a
    // ledger entry — the ledger is what is on a bracelet, and a pass is not.
    //
    // Readable by every role, like the colours and unlike merch: reception needs
    // the list to sell from, and a price is not somebody's personal data.
    match /doorPasses/{passId} {
      allow read: if canRead();

      allow create, update: if isAdmin() && isWellFormedPass();
      allow delete: if isAdmin();

      function isWellFormedPass() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'price', 'sortOrder', 'isActive', 'kind'])
          && d.keys().hasAll(['name', 'price', 'sortOrder', 'isActive', 'kind'])
          // `name` is written verbatim onto the participant as `ticketType`, and
          // `isWellFormedDoorPass` checks the two agree — so this bound is also
          // the bound on a pass type anybody can be sold.
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          // Cents, like every other price here. The ceiling is a typo bound: a
          // 2,000 € festival pass is a slipped decimal, not a product.
          && d.price is int && d.price >= 0 && d.price <= 200000
          && d.sortOrder is int && d.sortOrder >= 0
          && d.isActive is bool
          // `evening` routes the terminal to the anonymous numbered flow instead
          // of asking for a name. It is a behaviour, not a label, which is why
          // it is a field the rules know about rather than a name match.
          && d.kind in ['pass', 'evening'];
      }
    }

    // ── Bracelet colours ─────────────────────────────────────────────────
    //
    // Which colour of wristband a pass type gets. One document per pass type,
    // keyed by a slug of it, set by organisers in the admin panel.
    //
    // Readable by every role rather than reception only, unlike merch: the
    // colour is a function of `ticketType`, which every terminal already reads
    // off the participant. Restricting it would protect nothing and would mean
    // a bar terminal silently showing no colour, which is the failure mode we
    // just spent an evening on.
    match /braceletColours/{passTypeId} {
      allow read: if canRead();

      // Organisers only, exactly like the drinks menu. No terminal writes here,
      // whatever it is compiled to send.
      allow create, update: if isAdmin() && isWellFormedColour();
      allow delete: if isAdmin();

      function isWellFormedColour() {
        let d = request.resource.data;
        return d.keys().hasOnly(['passType', 'level', 'colour', 'name'])
          && d.keys().hasAll(['passType', 'colour'])
          // Absent or empty means "any level", which is what a pass type with
          // one colour uses and what everything falls back to. A named level
          // must be one of the four the Sheet has, because a fifth would match
          // nobody and look like a mapping that silently does nothing.
          && (!('level' in d)
                || d.level == ''
                || d.level in ['Intermediate', 'Advanced', 'Pro', 'Other'])
          // The pass type verbatim, as it appears on a participant. The apps
          // match on this string rather than on the document id, so an id that
          // disagreed with its contents would simply never match anybody.
          && d.passType is string
          && d.passType.size() > 0
          && d.passType.size() <= 100
          // `#RRGGBB`, upper case. Pinned because both apps parse it: Swift has
          // no forgiving colour parser, and a value like "red" or "#f00" would
          // reach a phone as no colour at all.
          && d.colour is string
          && d.colour.matches('^#[0-9A-F]{6}$')
          // What staff call it out loud. Optional — a swatch is enough on
          // screen — but useful when the room is dark and two colours are close.
          && (!('name' in d) || (d.name is string && d.name.size() <= 40));
      }
    }

    // Anything not matched above is denied by default.
  }
}
