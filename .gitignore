# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Per-user Xcode state. The shared scheme in xcshareddata IS committed, so
# `xcodebuild -scheme BuzzTerminal` works on a fresh clone.
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/
# Package.resolved IS committed. That convention ("ignore it") is for libraries,
# whose consumers resolve their own versions. This is an application: pinning the
# exact Firebase graph means a fresh clone, and a future CI, build the same bytes.

# Node (the roster importer, the rules tests, the web admin panel)
node_modules/
npm-debug.log*
dist/

# The web panel's Firebase config. Not a credential in the way a service-account
# key is — a web config is shipped inside every web app that talks to the project,
# and what protects the roster is firestore.rules plus the admin custom claim, not
# the obscurity of an API key. Ignored anyway, so that "project configuration
# stays out of git" is one rule rather than three. .env.example and .env.emulator
# ARE committed; they contain nothing real.
.env.local
.env.*.local

# Android / Gradle. The wrapper (gradlew, gradle/wrapper/) IS committed — same
# reasoning as Package.resolved above: a fresh clone must build the same bytes
# without anyone choosing a Gradle version by hand.
.gradle/
local.properties
.kotlin/
.cxx/

# Android Studio's project files, which it rewrites as you use it — window
# layouts, the last device you deployed to, caches. Everything needed to build
# is in the Gradle files, and what was tracked here was Studio's own defaults
# (KOTLIN_OFFICIAL, the stock XML arrangement) rather than anything chosen. Note
# the contrast with xcshareddata above, which IS committed because a scheme is a
# real build input.
.idea/

# Android release signing. The keystore is the strongest credential in the
# project: whoever holds it can publish an update that every staff phone will
# install over the real app, and it can never be rotated for an app that is
# already out there. keystore.properties carries its passwords in plain text.
*.jks
*.keystore
keystore.properties

# Firebase. Never commit these: the plist and the json identify the project, and
# a service-account key is full admin access to it.
GoogleService-Info.plist
google-services.json
serviceAccountKey.json
*-serviceAccount*.json
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# Signing and distribution. The .p8 App Store Connect key is downloadable exactly
# once and authorises uploads as your team; ExportOptions.plist is generated per
# build and carries the team id.
AuthKey_*.p8
*.p12
*.mobileprovision
*.certSigningRequest
ExportOptions.plist

# Claude Code's per-user state. `.claude/launch.json` IS committed — it names how
# to start the web panel, which is a real project fact — but the permission
# allowlist is one person's answers on one machine.
.claude/settings.local.json

# macOS
.DS_Store

# Local scratch
screenshots/
